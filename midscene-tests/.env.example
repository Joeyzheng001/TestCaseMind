# ============================================================
# Midscene 运行所需的环境变量配置
# 复制此文件为 .env 并填入真实的 API Key
# ============================================================

# --- 必填：模型配置（二选一） ---

# 方案 A：内部 Qwen3.5-397B (qwen-chat)，支持视觉多模态、256k 上下文
MIDSCENE_MODEL_NAME=qwen-chat
MIDSCENE_MODEL_API_KEY=sk-60e2e4249b864ac6b810ff8fa2893f55
MIDSCENE_MODEL_BASE_URL=https://llm.htffund.com/v1
MIDSCENE_MODEL_FAMILY=qwen3-vl

# 方案 B：阿里云 DashScope (qwen-vl-max)
# MIDSCENE_MODEL_NAME=qwen-vl-max
# MIDSCENE_MODEL_API_KEY=your-dashscope-api-key
# MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MIDSCENE_MODEL_FAMILY=qwen3-vl

# --- 可选：高级配置 ---
# MIDSCENE_MODEL_TIMEOUT=60000
# MIDSCENE_MODEL_TEMPERATURE=0.1
# MIDSCENE_MODEL_RETRY_COUNT=2
