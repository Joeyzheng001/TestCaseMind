# LLM API
# 原生 Anthropic:
#   ANTHROPIC_BASE_URL 留空
#   ANTHROPIC_MODEL=claude-opus-4-1
#
# Anthropic-compatible provider, e.g. DeepSeek:
#   LLM_PROVIDER=deepseek
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#   MODEL_ID=deepseek-v4-pro
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_api_key_here
# 默认使用 x-api-key/API key 认证。只有兼容端点明确要求 Bearer token 时才改成 auth_token。
ANTHROPIC_AUTH_MODE=api_key
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-opus-4-1
MODEL_ID=

# Project paths
PROJECT_ROOT=./
KNOWLEDGE_BASE_PATH=./knowledge_base
OUTPUT_PATH=./output

# Knowledge sources
ARXIV_API=true
SEMANTICSCHOLAR_API=true
CROSSREF_API=true

# Citation settings
DEFAULT_CITATION_STYLE=apa
CITATION_FORMATS=apa,chicago,harvard,gb7714

# Document settings
DEFAULT_OUTPUT_FORMAT=docx
ENABLE_XMIND_EXPORT=true
ENABLE_PDF_EXPORT=true

# AIGC Detection
ENABLE_AIGC_DETECTION=true
AIGC_THRESHOLD=0.7

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/thesis_mind.log

# License verification
# 客户端/交付包只配置公钥；私钥只放在受控的许可证签发环境。
THESISMIND_LICENSE_PUBLIC_KEY=
# THESISMIND_LICENSE_PRIVATE_KEY=
# 旧版 HMAC 兼容验证可显式设置；不要在分发包中提供共享密钥。
# THESISMIND_LICENSE_KEY=
