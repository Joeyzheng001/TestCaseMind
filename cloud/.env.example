# Database
DATABASE_URL=postgresql+asyncpg://thesismind:thesismind@localhost:5432/thesismind

# License signing keypair (generate with Ed25519)
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# CDN base URL for release/PPT downloads
CDN_BASE_URL=https://cdn.thesismind.com

# Rate limiting
RATE_LIMIT_PER_IP=100

# Trial config
TRIAL_DAYS=3
MAX_DEVICES_PER_LICENSE_BASIC=1
MAX_DEVICES_PER_LICENSE_PRO=2
MAX_DEVICES_PER_LICENSE_VIP=3

# Proxy (optional, for calling DeepSeek CN API from overseas)
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=localhost,127.0.0.1
