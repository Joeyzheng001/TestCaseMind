# LLM API
# 默认使用 DeepSeek 兼容端点。也可在 Web 页面「基本配置」中切换其他服务商。
# 支持 Anthropic 原生、OpenAI、DeepSeek、MiniMax、智谱等兼容端点。
#
# 首次使用请在 Web 页面「基本配置」中填写 API Key 并点击「测试连接」，
# 系统会自动将 API Key 写入本文件。
LLM_PROVIDER=deepseek
ANTHROPIC_API_KEY=your_api_key_here
# 默认使用 x-api-key/API key 认证。只有兼容端点明确要求 Bearer token 时才改成 auth_token。
ANTHROPIC_AUTH_MODE=api_key
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro
MODEL_ID=deepseek-v4-pro
LLM_MAX_TOKENS=8000

# Project paths
PROJECT_ROOT=./
KNOWLEDGE_BASE_PATH=./knowledge_base
# 用户数据目录（论文工作区、草稿、导出文件）。默认 ~/.thesismind/
# 放在项目目录外部，重装/升级不会丢失数据。
OUTPUT_PATH=~/.thesismind/output

# Knowledge sources
ARXIV_API=true
SEMANTICSCHOLAR_API=true
CROSSREF_API=true

# Citation settings
DEFAULT_CITATION_STYLE=apa
CITATION_FORMATS=apa,chicago,harvard,gb7714

# Document settings
DEFAULT_OUTPUT_FORMAT=docx
ENABLE_XMIND_EXPORT=true
ENABLE_PDF_EXPORT=true

# AIGC Detection
ENABLE_AIGC_DETECTION=true
AIGC_THRESHOLD=0.7

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/thesis_mind.log

# License verification
# 客户端/交付包只配置公钥；私钥只放在受控的许可证签发环境。
THESISMIND_LICENSE_PUBLIC_KEY=9ukqWcoMOX+6YmlSgYY2q8zMdgB2CqhAN8pNW/puPk4=
# THESISMIND_LICENSE_PRIVATE_KEY=
# 旧版 HMAC 兼容验证可显式设置；不要在分发包中提供共享密钥。
# THESISMIND_LICENSE_KEY=
